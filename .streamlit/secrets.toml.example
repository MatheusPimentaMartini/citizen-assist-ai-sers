# Copie este arquivo para .streamlit/secrets.toml (que está no .gitignore) e preencha.
# No Streamlit Community Cloud, cole o mesmo conteúdo em: App > Settings > Secrets.
# NUNCA coloque a chave real neste arquivo de exemplo nem em nenhum arquivo versionado.

OLLAMA_API_KEY = "cole-aqui-a-sua-chave-do-ollama"
OLLAMA_MODEL = "gpt-oss:20b"     # plano gratuito; "gpt-oss:120b" consome mais e pode exigir créditos (erro 402)
# OLLAMA_HOST = "https://ollama.com"          # padrão (Ollama Cloud)
# OLLAMA_HOST = "http://localhost:11434"      # Ollama instalado no próprio computador (dispensa chave)
